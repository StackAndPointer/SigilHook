@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(SIGILHOOK_BUILD_SHARED_LIBS @SIGILHOOK_BUILD_SHARED_LIBS@)
set(SIGILHOOK_BUILD_DLL @SIGILHOOK_BUILD_SHARED_LIBS@)
set(SIGILHOOK_BUILD_STATIC_RUNTIME @SIGILHOOK_BUILD_STATIC_RUNTIME@)

set(SIGILHOOK_FEATURE_EXCEPTION @SIGILHOOK_FEATURE_EXCEPTION@)
set(SIGILHOOK_FEATURE_DETOURS @SIGILHOOK_FEATURE_DETOURS@)
set(SIGILHOOK_FEATURE_INLINENTD @SIGILHOOK_FEATURE_INLINENTD@)
set(SIGILHOOK_FEATURE_PE @SIGILHOOK_FEATURE_PE@)
set(SIGILHOOK_FEATURE_VIRTUALS @SIGILHOOK_FEATURE_VIRTUALS@)
set(SIGILHOOK_FEATURE_ANGELSCRIPT @SIGILHOOK_FEATURE_ANGELSCRIPT@)
set(SIGILHOOK_USE_EXTERNAL_ANGELSCRIPT @SIGILHOOK_USE_EXTERNAL_ANGELSCRIPT@)

if(SIGILHOOK_FEATURE_ANGELSCRIPT AND SIGILHOOK_USE_EXTERNAL_ANGELSCRIPT)
    find_dependency(Angelscript CONFIG)
endif()

find_dependency(Zydis)
if(SIGILHOOK_FEATURE_DETOURS)
    find_dependency(asmjit)
endif()
if(SIGILHOOK_FEATURE_INLINENTD)
    find_dependency(asmtk)
endif()

get_filename_component(SIGILHOOK_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include("${SIGILHOOK_CMAKE_DIR}/SigilHook-targets.cmake")
